# ============================================================================
# The single source of truth for a launch. Nothing else needs editing.
# `npm run preview` parses, validates and simulates this before you sign.
#
# Keep several launches side by side with DOTENV_CONFIG_PATH:
#   DOTENV_CONFIG_PATH=.env.mainnet npm run preview
# ============================================================================

# --- Network and wallets ----------------------------------------------------
RPC_URL=https://api.devnet.solana.com

# Partner owns the config. FIXED FOREVER — no instruction can reassign it.
PARTNER_KEYPAIR=~/.config/solana/id.json
# Creator creates the pool. Transferable later via transfer_pool_creator.
# Leave unset to use the partner wallet for both roles.
# CREATOR_KEYPAIR=~/.config/solana/creator.json

# --- Token ------------------------------------------------------------------
TOKEN_NAME=My Token
TOKEN_SYMBOL=MYTKN
# URL of the metadata JSON, NOT of the image. See metadata/README.md.
TOKEN_URI=https://gateway.irys.xyz/REPLACE_ME
TOKEN_TOTAL_SUPPLY=1000000000
TOKEN_DECIMALS=6                  # 6 | 7 | 8 | 9
TOKEN_PROGRAM=spl                 # spl | token2022
# immutable = name, symbol and URI can never be changed. Strongest signal,
# but a broken TOKEN_URI stays broken forever. creator | partner keep control.
TOKEN_AUTHORITY=immutable
# Unsold base tokens, handed LIQUID to the partner at migration. A separate
# bucket from VESTING_AMOUNT: 200000000 in both reserves 400M, not 200M.
TOKEN_LEFTOVER=1
# Optional: split the leftover between two wallets instead of leaving it on the
# partner wallet. `launchpad migrate` (right after migrating) or `launchpad claim`
# withdraws it and forwards both parts in one atomic transaction. Each wallet gets
# exactly its amount, in whole tokens; the two must not exceed TOKEN_LEFTOVER.
# The rest, including curve rounding (~75 tokens on a 150M leftover), stays on
# the partner wallet.
# Anyone may withdraw the leftover first, unsplit, onto the partner wallet: claim
# detects it and sends the split with `launchpad claim --forward-leftover`.
# For a Squads multisig, use the VAULT address, not the multisig address:
# tokens sent to the multisig account itself can never be moved again.
# `npm run preview` checks both addresses against the RPC_URL cluster.
LEFTOVER_COMMUNITY_WALLET=
LEFTOVER_TREASURY_WALLET=
LEFTOVER_COMMUNITY_AMOUNT=
LEFTOVER_TREASURY_AMOUNT=
# Everything below only feeds the generated metadata JSON (npm run metadata),
# never the program. Shown on wallets, DexScreener and Jupiter.
TOKEN_DESCRIPTION=One or two sentences about the project.
# URL of your uploaded logo. Upload the image first, then paste it here.
TOKEN_IMAGE=
TOKEN_WEBSITE=
TOKEN_TWITTER=
TOKEN_TELEGRAM=


# --- Curve ------------------------------------------------------------------
# The token traders pay with: sol | usdc | usdc-devnet
QUOTE_TOKEN=sol
# Market caps in QUOTE_TOKEN units. MIGRATION_MARKET_CAP also drives how much
# must be raised to graduate — preview prints the exact figure and its USD
# value at the live rate. Meteora's mainnet keepers only auto-migrate pools
# raising 10+ SOL, 750+ USDC or 1500+ JUP.
INITIAL_MARKET_CAP=65
MIGRATION_MARKET_CAP=250

# --- Trading fees -----------------------------------------------------------
# Fees start high and decay, which taxes snipers and not later buyers.
# Set start == end for a flat fee, and then both DECAY keys must be 0.
TRADING_FEE_START_BPS=2000        # 20%
TRADING_FEE_END_BPS=100           #  1%, min 25, max 9900
FEE_DECAY_PERIODS=1
FEE_DECAY_SECONDS=2               # SECONDS. 3600 spreads the decay over an hour.
FEE_DECAY_MODE=linear             # linear | exponential
DYNAMIC_FEE=false                 # extra volatility-responsive layer
COLLECT_FEE_MODE=quote            # quote = earn in SOL | output = earn in your token
# Share of trading fees AND post-migration surplus going to the creator.
CREATOR_FEE_PCT=100
POOL_CREATION_FEE=0               # charged to others creating pools from this config
FIRST_SWAP_MIN_FEE=false

# --- Migration --------------------------------------------------------------
# Fee the graduated DAMM v2 pool charges traders. A protocol cut of 20% is
# taken out of it, and the rest is split pro-rata across pool liquidity.
MIGRATION_FEE_OPTION=fixed_30bps  # fixed_25bps | fixed_30bps | fixed_100bps
                                  # fixed_200bps | fixed_400bps | fixed_600bps
# Your cut of the raise, taken at migration. 0 = take nothing.
MIGRATION_FEE_PCT=0
MIGRATION_CREATOR_FEE_PCT=0       # must be 0 when MIGRATION_FEE_PCT is 0

# --- Migrated liquidity -----------------------------------------------------
# Must total exactly 100, with at least 10 locked. Locked liquidity cannot be
# withdrawn but keeps earning pool fees, and its position NFT is transferable.
LP_PARTNER_PCT=0
LP_PARTNER_LOCKED_PCT=0
LP_CREATOR_PCT=0
LP_CREATOR_LOCKED_PCT=100

# --- Team vesting -----------------------------------------------------------
# Base tokens locked in an escrow that unlocks after migration. Set to 0 for
# no team allocation. Max duration is 63072000 seconds (2 years).
VESTING_AMOUNT=200000000
VESTING_PERIODS=18
VESTING_CLIFF_AMOUNT=0            # released at the cliff, before periodic unlocks
VESTING_DURATION_S=47304000       # 18 months
VESTING_CLIFF_S=0

# --- Buying -----------------------------------------------------------------
# Amounts in QUOTE_TOKEN units.
# Your own buy, bundled into the pool creation transaction so it cannot be sniped.
FIRST_BUY=0.1
BUY_AMOUNT=0.05                   # used only by `npm run buy`
# Tokens sold by `npm run sell`, in whole tokens (not quote), or `all`.
SELL_AMOUNT=all
SLIPPAGE_BPS=100                  # used by `npm run buy` and `npm run sell`
